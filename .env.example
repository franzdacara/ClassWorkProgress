# OpenRouter API key - get one at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Models to try in order (comma-separated). The next one is used if a model is busy or returns nothing.
VITE_OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,openrouter/free
